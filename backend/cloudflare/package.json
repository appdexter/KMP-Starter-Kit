{
  "name": "koko-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers edge backend for Koko (KMP Contest Starter Kit) handling attribution sync, subscription webhooks, Meta CAPI, and Google Ads conversions.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute koko-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute koko-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
