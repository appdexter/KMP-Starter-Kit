{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koko-backend",
  "account_id": "da0e99770e4d3623b4d5665d01b52084",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koko-db",
      "database_id": "3f168b91-a061-4406-8966-3f9198e56649"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
